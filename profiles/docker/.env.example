# OpenCode runtime
OPENCODE_ENABLE_EXA=1
OPENCODE_EXPERIMENTAL=true

# MCP server credentials — only needed for the servers you enable in opencode.json.
# context7 and playwright require no credentials.

# github MCP: a GitHub personal access token (scopes: repo, read:org)
GITHUB_TOKEN=

# postgres MCP: a Postgres connection string, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=

# context7 (optional): a free key from https://context7.com raises rate limits
# CONTEXT7_API_KEY=
