{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md"
    ],
    "formatter": {
        "prettier": {
            "command": [
                "npx",
                "prettier",
                "--write",
                "$FILE"
            ],
            "environment": {
                "NODE_ENV": "development"
            }
        }
    },
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        },
        "postgres": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-postgres",
                "{env:DATABASE_URL}"
            ],
            "enabled": false
        }
    },
    "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
            "*": "allow"
        },
        "bash": {
            "*": "ask",
            "ls": "allow",
            "ls *": "allow",
            "pwd": "allow",
            "cd *": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "wc *": "allow",
            "sort *": "allow",
            "uniq *": "allow",
            "cut *": "allow",
            "column *": "allow",
            "diff *": "allow",
            "tree": "allow",
            "tree *": "allow",
            "stat *": "allow",
            "file *": "allow",
            "du *": "allow",
            "df *": "allow",
            "basename *": "allow",
            "dirname *": "allow",
            "realpath *": "allow",
            "which *": "allow",
            "type *": "allow",
            "echo *": "allow",
            "printf *": "allow",
            "date": "allow",
            "date *": "allow",
            "env": "allow",
            "printenv*": "allow",
            "whoami": "allow",
            "uname *": "allow",
            "true": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "fd *": "allow",
            "jq *": "allow",
            "yq *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git show*": "allow",
            "git branch": "allow",
            "git branch -v*": "allow",
            "git branch --list*": "allow",
            "git remote*": "allow",
            "git rev-parse*": "allow",
            "git describe*": "allow",
            "git blame*": "allow",
            "git ls-files*": "allow",
            "git shortlog*": "allow",
            "git tag": "allow",
            "git tag -l*": "allow",
            "git stash list*": "allow",
            "git config --get*": "allow",
            "git config --list*": "allow",
            "git fetch*": "allow",
            "node --version": "allow",
            "npm --version": "allow",
            "npm ls*": "allow",
            "npm list*": "allow",
            "npm view*": "allow",
            "npm outdated*": "allow",
            "npm run lint*": "allow",
            "npm run typecheck*": "allow",
            "npm test*": "allow",
            "npx prettier*": "allow",
            "npx tsc --noEmit*": "allow",
            "pnpm list*": "allow",
            "pnpm why*": "allow",
            "pnpm test*": "allow",
            "yarn list*": "allow",
            "yarn test*": "allow",
            "eslint*": "allow",
            "tsc --noEmit*": "allow",
            "python --version": "allow",
            "python3 --version": "allow",
            "pip list*": "allow",
            "pip show*": "allow",
            "pip freeze*": "allow",
            "pytest*": "allow",
            "ruff*": "allow",
            "mypy*": "allow",
            "black --check*": "allow",
            "flake8*": "allow",
            "go version": "allow",
            "go list*": "allow",
            "go vet*": "allow",
            "go test*": "allow",
            "cargo --version": "allow",
            "cargo tree*": "allow",
            "cargo check*": "allow",
            "cargo clippy*": "allow",
            "cargo test*": "allow",
            "make test*": "allow",
            "make lint*": "allow",
            "./scripts/test.sh*": "allow",
            "bash scripts/test.sh*": "allow",
            "docker ps*": "allow",
            "docker images*": "allow",
            "docker inspect*": "allow",
            "docker logs*": "allow",
            "docker version*": "allow",
            "docker compose config*": "allow",
            "docker compose ps*": "allow",
            "kubectl get*": "allow",
            "kubectl describe*": "allow",
            "kubectl logs*": "allow",
            "kubectl config get-contexts*": "allow",
            "git commit*": "ask",
            "git push*": "ask",
            "git reset*": "ask",
            "git rebase*": "ask",
            "git checkout*": "ask",
            "git merge*": "ask",
            "git cherry-pick*": "ask",
            "rm -rf*": "deny",
            "rm -fr*": "deny",
            "sudo*": "deny",
            "shutdown*": "deny",
            "reboot*": "deny",
            "halt*": "deny",
            "poweroff*": "deny",
            "mkfs*": "deny",
            "dd *": "deny",
            "git reset --hard*": "deny",
            "git clean -f*": "deny",
            "git clean -d*": "deny",
            "git push --force*": "deny",
            "git push -f*": "deny",
            "docker system prune*": "deny",
            "docker volume rm*": "deny",
            "docker volume prune*": "deny"
        }
    },
    "default_agent": "backend"
}
